generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS (Listas de valores permitidos) ---
enum TipoGateway {
  CENTRAL
  REPETIDOR
}

enum EstadoDispositivo {
  ACTIVO
  INACTIVO
  MANTENIMIENTO
  ALERTA
}



// --- TABLAS PRINCIPALES ---

model Cliente {
  id               Int               @id @default(autoincrement())
  nombre           String            
  rut              String?
  email            String?
  telefono         String?           
  latitud          Float?            // <-- NUEVO
  longitud         Float?            // <-- NUEVO
  sectores         Sector[]
  infraestructuras Infraestructura[] 
  gateways         Gateway[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// Polígonos estructurales (Caseta, Casa, Centro de Control)
model Infraestructura {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  nombre      String   // ej: "Caseta Central Gateway"
  tipo        String   // ej: "CASETA", "BODEGA", "CASA"
  coordenadas Json     // Array del polígono
  color       String?  @default("#38bdf8") // Celeste por defecto
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Polígonos de plantación
model Sector {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  nombre      String   // ej: "Sector 1"
  cultivo     String?  // ej: "Cerezos", "Paltos"
  coordenadas Json     // Array del polígono
  color       String?  @default("#22c55e") // Verde por defecto
  nodos       Nodo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Topología de Red LoRa
model Gateway {
  id          String   @id
  estado      String
  latitud     Float?
  longitud    Float?
  nombre      String?  
  clienteId   Int?     
  cliente     Cliente? @relation(fields: [clienteId], references: [id]) 

  // Agrega esta línea para resolver el error P1012:
  nodos       Nodo[]
}

// Nodos TinyML en terreno
model Nodo {
  id          String            @id // ej: "AGV-011"
  sectorId    Int?
  sector      Sector?           @relation(fields: [sectorId], references: [id])
  gatewayId   String?           // Por cuál gateway está ruteando su señal
  gateway     Gateway?          @relation(fields: [gatewayId], references: [id])
  latitud     Float?
  longitud    Float?
  estado      EstadoDispositivo @default(ACTIVO)
  bateria     Int?              @default(100)
  lecturas    Lectura[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  ultimaMantencion DateTime?
}

// El Payload Histórico (Optimizada para IoT)
model Lectura {
  id          Int      @id @default(autoincrement())
  nodoId      String
  nodo        Nodo     @relation(fields: [nodoId], references: [id])
  
  // Variables Críticas (AgroVox)
  cavitacion  Boolean
  bateria     Int      // Porcentaje 0-100
  
  // Calidad de Red (LoRaWAN)
  rssi        Int?     // Potencia de señal en dBm (ej: -115)
  snr         Float?   // Relación señal-ruido
  
  // Variables Ambientales (Preparado para el futuro)
  temperatura Float?   
  humedad     Float?   
  
  createdAt   DateTime @default(now())

  whatsappEnviado  Boolean  @default(false)
  riegoConfirmado Boolean  @default(false)
}


model AlertaSistema {
  id          Int       @id @default(autoincrement())
  titulo      String    // ej: "Batería solar crítica (12%)"
  descripcion String?   // ej: "El panel solar no registra carga suficiente..."
  severidad   String    // "high" | "medium" | "info"
  estado      String    @default("pending") // "pending" | "resolved"
  categoria   String    @default("ENERGIA") // "CONECTIVIDAD" | "ENERGIA" | "RED_LORA" | "SISTEMA"
  dispositivo String    // ej: "AGV-042" o "GW-CEN-01"
  ubicacion   String    // ej: "Fundo El Encanto • Sector 3"
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model ConfiguracionSistema {
  id                  Int      @id @default(1)
  bateriaMinima       Int      @default(20)   // % bajo el cual se dispara alerta de energía
  voltajeReferenciaMv Int      @default(24)   // mV de umbral acústico TinyML por defecto
  heartbeatTimeoutMin Int      @default(60)   // Minutos sin señal para marcar offline
  rssiMinimoDbm       Int      @default(-110) // dBm mínimos antes de alerta de señal LoRa
  whatsappHabilitado  Boolean  @default(true) // Master switch de envíos WhatsApp
  autoResolverAlertas Boolean  @default(true) // Cierra el ticket si la batería sube del umbral
  updatedAt           DateTime @updatedAt
}

model ContactoNotificacion {
  id             Int      @id @default(autoincrement())
  clienteId      Int?
  sectorId       Int?
  ubicacionLabel String   // ej: "Fundo El Encanto — Sector 3" o "Agrícola San Pedro — General"
  nombre         String?  // ej: "Juan Pérez"
  rol            String   // ej: "Capataz de Riego", "Agrónomo"
  telefono       String   // ej: "+56 9 8765 4321"
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
}